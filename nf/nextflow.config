params {
    input        = null        // dir of *.fcs; unset -> demo fixtures
    demo_events  = 200
    outdir       = "results"
}

process {
    executor = 'local'
}

// Per-task trace is the substrate for run receipts
// (scripts/run_receipts.py). Written under outdir alongside results.
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.txt"
    fields    = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,workdir'
}
